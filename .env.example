# ===============================
# AI Real Estate Deal Analyzer
# Example environment variables
# ===============================
#
# Copy to `.env` to use:   cp .env.example .env
#
# WHY THE VALUES HERE ARE THE CODE DEFAULTS
# -----------------------------------------
# `.env` is gitignored, and VS Code's Python extension auto-loads it (`python.envFile`
# defaults to ${workspaceFolder}/.env). That combination is a reproducibility trap: a run
# launched from the VS Code debugger can silently differ from `python main.py` in a
# terminal, and a generated report cannot be reproduced by anyone lacking your `.env`.
#
# So every value below is the value the code itself defaults to. Copy this file verbatim —
# or keep no `.env` at all — and a run reproduces the committed reference output. Change a
# value only when you intend the numbers to change, and note that the report does not
# record which knobs were active when it was written.
#
# Each entry cites the module that reads it. Booleans accept 1/true/yes/on.


# --- Run options -------------------------------------------------------------
# Override AppInputs.run.* from the config JSON; CLI flags win over these.
# Commented out = defer to the config file (or the committed sample bundle).
#
# AIREAL_OUT=investment_analysis.md                              # src/inputs/inputs.py
# AIREAL_HORIZON=10                                              # years, 1..50
# AIREAL_LISTING=data/sample_listings/36_kelly_moncton/listing.txt
# AIREAL_PHOTOS=data/sample_listings/36_kelly_moncton/photos
# AIREAL_ENGINE=deterministic    # deterministic | crewai. The crewai engine is a parity
#                                # shell: it validates the env and delegates to the same
#                                # deterministic math. It does not call an LLM.

AIREAL_SCENARIOS=0             # Opt-in Market Scenarios overlay. OFF by default; with it
                               # OFF the report is byte-identical to a pre-overlay run.
                               # Needs a `market` block in the inputs (or
                               # market.cap_rate_purchase set) or the run loud-fails.


# --- Financial modeling assumptions -----------------------------------------
# These change reported NUMBERS and are the most likely cause of two runs disagreeing.

AIREAL_CAP_DRIFT_BPS=0         # Cap-rate drift, basis points per year, applied to the
                               # NOI-based valuation table. 0 = flat.
                               # Example: 5 drifts a 6.35% cap to 6.80% over 10 years,
                               # materially inflating later-year values and equity.
                               # src/core/reports/generator.py

AIREAL_APPRECIATION_PCT=0.03   # Baseline appreciation rate as a fraction (0.03 = +3%/yr),
                               # used by the Baseline valuation track.

AIREAL_STRESS_ADJ=0.0          # Basis adjustment subtracted from the purchase price before
                               # compounding in the Stress-Test valuation track.


# --- Computer vision (photo tagging) ----------------------------------------

AIREAL_USE_VISION=0            # 0 = deterministic filename/pixel heuristics only.
                               # 1 = AI photo-tagging path, which CHANGES which amenities
                               #     appear in the report, so it affects reproducibility.
                               # Read ONCE at module import (a module-level constant in
                               # src/orchestrators/cv_tagging_orchestrator.py) — setting it
                               # after import has no effect.


# --- LLM / Orchestration (opt-in seam) --------------------------------------

AIREAL_LLM_MODE=               # Empty = off.  src/agents/crewai_components.py
AIREAL_DEBUG=                  # Empty = off. Verbose agent logging; diagnostic only,
                               # does not change report content.

# Only consulted on the `crewai` engine path. The deterministic pipeline reads no API keys
# and imports no provider SDK.
# OPENAI_API_KEY=              # or ANTHROPIC_API_KEY / OPENROUTER_API_KEY
# CREWAI_MODEL=gpt-4o-mini     # falls back to OPENAI_MODEL, then "gpt-4o-mini"


# --- Documented but NOT implemented -----------------------------------------
# The names below appeared in earlier versions of this file and in docstrings, but NO code
# reads them — setting them has no effect. Verified absent from src/ and main.py. Listed
# here so they are not copied forward in the belief that they do something:
#
#   AIREAL_PHOTO_AGENT         (only in main.py / listing_analyst.py docstrings)
#   AIREAL_VISION_PROVIDER     (only in a listing_analyst.py docstring)
#   AIREAL_VISION_MODEL        (appears nowhere)
#   AIREAL_VISION_TIMEOUT_S    (appears nowhere)
#   AIREAL_VISION_MAX_RETRIES  (appears nowhere)
